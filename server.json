{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.hermoso-ai/hermoso",
  "title": "Hermoso",
  "description": "Launch and market what your AI built. 1831 tools, usable alone. Start free: 160+ credits. No markup.",
  "version": "0.1.687",
  "websiteUrl": "https://hermoso.ai/mcp/",
  "repository": {
    "url": "https://github.com/hermoso-ai/hermoso",
    "source": "github"
  },
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://app.hermoso.ai/mcp?src=registry"
    },
    {
      "type": "streamable-http",
      "url": "https://app.hermoso.ai/mcp/full?src=registry"
    },
    {
      "type": "streamable-http",
      "url": "https://app.hermoso.ai/mcp/all?src=registry"
    },
    {
      "type": "streamable-http",
      "url": "https://app.hermoso.ai/mcp/lean?src=registry"
    },
    {
      "type": "streamable-http",
      "url": "https://app.hermoso.ai/mcp/core?src=registry"
    },
    {
      "type": "streamable-http",
      "url": "https://app.hermoso.ai/mcp/create?src=registry"
    },
    {
      "type": "streamable-http",
      "url": "https://app.hermoso.ai/mcp/ads?src=registry"
    },
    {
      "type": "streamable-http",
      "url": "https://app.hermoso.ai/mcp/social?src=registry"
    },
    {
      "type": "streamable-http",
      "url": "https://app.hermoso.ai/mcp/sites?src=registry"
    },
    {
      "type": "streamable-http",
      "url": "https://app.hermoso.ai/mcp/analytics?src=registry"
    },
    {
      "type": "streamable-http",
      "url": "https://app.hermoso.ai/mcp/research?src=registry"
    },
    {
      "type": "streamable-http",
      "url": "https://app.hermoso.ai/mcp/reports?src=registry"
    },
    {
      "type": "streamable-http",
      "url": "https://app.hermoso.ai/mcp/scheduler?src=registry"
    },
    {
      "type": "streamable-http",
      "url": "https://app.hermoso.ai/mcp/creators?src=registry"
    },
    {
      "type": "streamable-http",
      "url": "https://app.hermoso.ai/mcp/gemini?src=registry"
    },
    {
      "type": "streamable-http",
      "url": "https://app.hermoso.ai/mcp/copilot?src=registry"
    },
    {
      "type": "streamable-http",
      "url": "https://app.hermoso.ai/mcp/s/{groups}?src=registry",
      "variables": {
        "groups": {
          "description": "Comma-separated tool groups: core, research, create, channels, channel_admin, analytics, ads, files, workspace.",
          "isRequired": true,
          "default": "core,research,create",
          "placeholder": "research,create"
        }
      }
    }
  ],
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "hermoso",
      "version": "0.1.687",
      "runtimeHint": "npx",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "mcp",
          "description": "Run the Hermoso stdio MCP server"
        }
      ],
      "environmentVariables": [
        {
          "name": "HERMOSO_TOKEN",
          "description": "Hermoso agent key (hmk_…) from app.hermoso.ai, on the MCP & CLI tab under Terminal & API keys. Required against the hosted app.",
          "isSecret": true,
          "isRequired": false
        },
        {
          "name": "HERMOSO_API_BASE",
          "description": "Hermoso API origin. Defaults to https://app.hermoso.ai; set http://localhost:3000 to run against your own server.",
          "isRequired": false
        }
      ]
    }
  ]
}
